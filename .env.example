# Variables d'environnement pour le dev local
# Copier ce fichier en .env et adapter les valeurs

POSTGRES_DB=geofoncier
POSTGRES_USER=geofoncier
POSTGRES_PASSWORD=geofoncier_dev_password

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=pgadmin_dev_password

APP_NAME=GeoFoncier API
APP_VERSION=0.1.0
API_PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://geofoncier:change_me_postgres_password@postgis:5432/geofoncier